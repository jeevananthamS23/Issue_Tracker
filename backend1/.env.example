# CivicVision AI — Backend Environment Configuration Example
# Copy this file to .env and configure the appropriate values for your environment.

# Server Port (defaults to 5000 if not specified)
PORT=5000

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/community_issues?retryWrites=true&w=majority

# JSON Web Token Secret Key (used for signing citizen and administrator session tokens)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Legacy Administrator Secret Key (retained for backward compatibility / administrative scripts)
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins
# Deployed citizen frontend origin:
CITIZEN_FRONTEND_ORIGIN=https://issue-tracker-kappa-pearl.vercel.app

# Deployed administrator frontend origin:
ADMIN_FRONTEND_ORIGIN=https://admin-frontend-beta-liard.vercel.app
