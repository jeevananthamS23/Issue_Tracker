# CivicVision AI — Standalone CLIP Microservice Configuration
# Copy to .env for local development

# Port and Host binding
PORT=8000
HOST=0.0.0.0

# Inference Engine Mode
# Set to "true" to load real HuggingFace weights (requires >=1GB RAM)
# Set to "false" to use offline deterministic unit-norm 512-D engine (suitable for CI/512MB RAM)
USE_ONLINE_MODEL=false

# CLIP Model Identifier
CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# Optional API Key Authorization (protects deployed endpoint from unauthorized public use)
# Leave blank for local development / test suites
# AI_SERVICE_API_KEY=your_strong_secret_key_here

# Allowed Image Hosts (comma-separated, wildcard supported)
ALLOWED_IMAGE_HOSTS=res.cloudinary.com,*.cloudinary.com,cloudinary.com

# Resource Limits
MAX_IMAGE_BYTES=15728640
MAX_IMAGE_PIXELS=25000000
